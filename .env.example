# ==============================================================================
# Enginne — configuração de ambiente (EXEMPLO — nenhum valor real aqui).
# Copie para .env e preencha. NUNCA commite o .env real no Git.
# ==============================================================================

NODE_ENV=production

# Porta em que o servidor HTTP/MCP escuta.
PORT=8787

# URL pública e ESTÁVEL deste servidor (a que você vai configurar no painel
# do Mercado Livre como base do Redirect URI). Deve ser HTTPS em produção.
# Local (teste com túnel, ex. ngrok): https://xxxx.ngrok-free.app
# Produção (Railway/Render/etc.): https://ml-enginne-production.up.railway.app
PUBLIC_BASE_URL=https://SEU-DOMINIO-AQUI

# Credenciais da aplicação criada em https://developers.mercadolivre.com.br
# (Minhas aplicações > sua app > Configurações). NUNCA coloque no código-fonte.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Domínio de autorização do país da conta (Brasil por padrão). Outros países:
# .ar (Argentina), .mx (México), .cl (Chile), .co (Colômbia), .uy (Uruguai),
# .pe (Peru), .ec (Equador), .ve (Venezuela).
ML_AUTH_DOMAIN=auth.mercadolivre.com.br
ML_API_BASE_URL=https://api.mercadolibre.com

# Chave mestra para cifrar access_token/refresh_token em repouso (AES-256-GCM).
# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Chave usada para proteger o endpoint /mcp (o conector do Claude envia isso
# como "Authorization: Bearer <valor>"). Gere com: openssl rand -base64 32
MCP_API_KEY=

# Caminho do arquivo SQLite. Em produção com disco efêmero (ex. containers
# sem volume), aponte para um volume persistente — ver README > Hospedagem.
DATABASE_PATH=./data/enginne.sqlite

LOG_LEVEL=info
